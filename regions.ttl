@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <http://example.com/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@base <http://example.com/base/> .

<Region> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "regionToCodes.csv";
        rml:referenceFormulation ql:CSV] ;
    rr:subjectMap [
        rr:template "http://foo.example/Region/{NHSER24NM}" ;
        rr:class ex:Region ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:name;
        rr:objectMap [ rml:reference "NHSER24NM"; rr:TermType rr:IRI;]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:code;
        rr:objectMap [ rml:reference "NHSER24CDH"; rr:TermType rr:IRI;]
    ].

<Score> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "gpPracticeScores.csv";
        rml:referenceFormulation ql:CSV] ;
    rr:subjectMap [
        rr:template "http://foo.example/Score/{ad_commissioningregionname}" ;
        rr:class ex:score ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:regionScore ;
        rr:objectMap [
            a rr:RefObjectMap ;
            rr:parentTriplesMap <Region> ;
            rr:joinCondition [rr:child "ad_commissioningregioncode" ; rr:parent "NHSER24CDH"; ]
        ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:regionCode ;
        rr:objectMap [rml:reference "ad_commissioningregioncode" ; rr:TermType rr:IRI]
    ] ;
    rr:predicateObjectMap [
            rr:predicate ex:population ;
            rr:objectMap [ rml:reference "popsize"; rr:TermType rr:IRI;]
        ] ;
    rr:predicateObjectMap [
            rr:predicate ex:phoneResponse ;
            rr:objectMap [ rml:reference "localgpservicesphone_1.count"; rr:TermType rr:IRI;]
        ] ;
    rr:predicateObjectMap [
            rr:predicate ex:webResponse ;
            rr:objectMap [ rml:reference "localgpserviceswebsite_1.count"; rr:TermType rr:IRI;]
        ] ;
    rr:predicateObjectMap [
            rr:predicate ex:appointmentResponse ;
            rr:objectMap [ rml:reference "localgpservicesapp_1.count"; rr:TermType rr:IRI;]
        ] ;
    rr:predicateObjectMap [
            rr:predicate ex:receptionResponse ;
            rr:objectMap [ rml:reference "localgpservicesreception_1.count"; rr:TermType rr:IRI;]
        ] ;
    rr:predicateObjectMap [
            rr:predicate ex:serviceUse ;
            rr:objectMap [ rml:reference "localgpservicesused_1.count"; rr:TermType rr:IRI;]
        ] ; 
    rr:predicateObjectMap [
            rr:predicate ex:missedCalls ;
            rr:objectMap [ rml:reference "gpcontactunsuccessful_1.count"; rr:TermType rr:IRI;]
        ].                  


    <Trust> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "trusts.csv";
        rml:referenceFormulation ql:CSV] ;
        rr:subjectMap [
        rr:template "http://foo.example/Trust/{orgCode}" ;
        rr:class ex:Region ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:name;
        rr:objectMap [ rml:reference "name"; rr:TermType rr:IRI;]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:orgCode;
        rr:objectMap [ rml:reference "orgCode"; rr:TermType rr:IRI;]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:town;
        rr:objectMap [ rml:reference "town"; rr:TermType rr:IRI;]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:town;
        rr:objectMap [ rml:reference "town"; rr:TermType rr:IRI;]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:region ;
        rr:objectMap [
            a rr:RefObjectMap ;
            rr:parentTriplesMap <Region> ;
            rr:joinCondition [rr:child "NHSER" ; rr:parent "NHSER24CDH"; ]
        ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:regionCode;
        rr:objectMap [ rml:reference "NHSER"; rr:TermType rr:IRI;]
    ].
