# Reporting periods
<RegionalReportingPeriodTripleMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "regional.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://foo.example/reportingPeriod/regional/{year}/{month}" ;
        rr:class nhs:ReportingPeriod
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:year ;
        rr:objectMap [rml:reference "year"; rr:datatype xsd:integer]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:month ;
        rr:objectMap [rml:reference "month"; rr:datatype xsd:integer]
    ] .

<SpendingReportingPeriodTripleMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "trustSpending.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://foo.example/reportingPeriod/spending/{year}" ;
        rr:class nhs:ReportingPeriod
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:year ;
        rr:objectMap [rml:reference "year"; rr:datatype xsd:integer]
    ] .


#ease of contacting GP

#overall experience with gp

#Survey questions
<SurveyQuestionTripleMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "gpSurvey.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://foo.example/surveyQuestion/{question}" ;
        rr:class nhs:SurveyQuestion
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:questionLabel ;
        rr:objectMap [rml:reference "label"; rr:datatype xsd:string]
    ] .

    #gp visit observations
<GpVisitFreqTripleMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "cleanScores.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://foo.example/PatientSurveyObservation/frequency/{ad_commissioningregioncode}" ;
        rr:class nhs:PatientSurveyObservation
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:value ;
        rr:objectMap [rml:reference "localgpservicesused_1.pct"; rr:datatype xsd:decimal]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:inRegion ;
        rr:objectMap [
            rr:template "http://foo.example/organisation/{ad_commissioningregioncode}";
            rr:termType rr:IRI;
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:answersSurveyQuestion ;
        rr:objectMap [
            rr:constant <http://foo.example/surveyQuestion/frequency>;
            rr:termType rr:IRI;
        ]
    ] .

    #overall gp score
    <gpScoreTripleMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "cleanScores.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://foo.example/PatientSurveyObservation/score/{ad_commissioningregioncode}" ;
        rr:class nhs:PatientSurveyObservation
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:value ;
        rr:objectMap [rml:reference "overallexp.pcteval"; rr:datatype xsd:decimal]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:inRegion ;
        rr:objectMap [
            rr:template "http://foo.example/organisation/{ad_commissioningregioncode}";
            rr:termType rr:IRI;
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:answersSurveyQuestion ;
        rr:objectMap [
            rr:constant <http://foo.example/surveyQuestion/score>;
            rr:termType rr:IRI;
        ]
    ] .

    #reception
    <receptionScoreTripleMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "cleanScores.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://foo.example/PatientSurveyObservation/reception/{ad_commissioningregioncode}" ;
        rr:class nhs:PatientSurveyObservation
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:value ;
        rr:objectMap [rml:reference "localgpservicesreception.pcteval"; rr:datatype xsd:decimal]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:inRegion ;
        rr:objectMap [
            rr:template "http://foo.example/organisation/{ad_commissioningregioncode}";
            rr:termType rr:IRI;
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:answersSurveyQuestion ;
        rr:objectMap [
            rr:constant <http://foo.example/surveyQuestion/reception>;
            rr:termType rr:IRI;
        ]
    ] .
