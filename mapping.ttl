@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix nhs: <http://example.com/group-g-ontology> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://example.com/base/> .

# NHS organisations
<RegionTripleMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "regionToCodes.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://foo.example/organisation/{NHSER24CDH}" ;
        rr:class nhs:NHSOrganisation
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:orgType ;
        rr:objectMap [rr:constant "region"; rr:datatype xsd:string]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:geoCode ;
        rr:objectMap [rml:reference "NHSER24CDH"; rr:datatype xsd:string]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:name ;
        rr:objectMap [rml:reference "NHSER24NM"; rr:datatype xsd:string]
    ] .

<TrustTripleMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "trusts.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://foo.example/organisation/{orgCode}" ;
        rr:class nhs:NHSOrganisation
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:orgType ;
        rr:objectMap [rr:constant "trust"; rr:datatype xsd:string]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:geoCode ;
        rr:objectMap [rml:reference "orgCode"; rr:datatype xsd:string]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:name ;
        rr:objectMap [rml:reference "name"; rr:datatype xsd:string]
    ] .

# Expenditure categories
<ExpenditureCategoryTripleMap> a rr:TriplesMap ;
        rml:logicalSource [
        rml:source "spendingCategories.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://foo.example/expenditureCategory/{categoryName}" ;
        rr:class nhs:ExpenditureCategory
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:categoryLabel ;
        rr:objectMap [rml:reference "label"; rr:datatype xsd:string]
    ] .

# Spending observationd
<SuppliesSpendingTripleMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "trustSpending.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://foo.example/spendingObservation/supplies/{orgCode}/{year}" ;
        rr:class nhs:SpendingObservation
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:value ;
        rr:objectMap [rml:reference "supplies"; rr:datatype xsd:decimal]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:observedInPeriod ;
        rr:objectMap [
            rr:template "http://foo.example/reportingPeriod/spending/{year}" ;
            rr:termType rr:IRI;
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:ExpenditureCategory ;
        rr:objectMap [
            rr:constant <http://foo.example/expenditureCategory/supplies>;
            rr:termType rr:IRI;
        ]
    ] .

