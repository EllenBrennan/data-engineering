        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://foo.example/workforceObservation/total/{regionName}/{year}/{month}" ;
        rr:class nhs:WorkforceObservation
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:value ;
        rr:objectMap [rml:reference "total_staff"; rr:datatype xsd:decimal]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:observedInPeriod ;
        rr:objectMap [
            rr:template "http://foo.example/reportingPeriod/regional/{year}/{month}" ;
            rr:termType rr:IRI;
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate nhs:StaffGroup ;
        rr:objectMap [
            rr:constant <http://foo.example/staffGroup/total>;
            rr:termType rr:IRI;
        ]
    ] .


